# CareerDiscover AI - Environment Variables Template
# Copy this file to .env or .env.local (Do not commit real secrets to Git)

# OpenAI API Key for AI Bullet Enhancement & Multi-Agent Orchestration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default Target LLM Model (gpt-4o-mini or gpt-4o)
VITE_OPENAI_MODEL=gpt-4o-mini
